{
  "name": "veyra-frontend",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Veyra administrative web interface (static Next.js export)",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --port 3000",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
