# Managed by Veyra installer — changes are overwritten by install.sh/upgrade.sh.
# The administrative interface listens only on the addresses below, which the
# installer restricts to private/loopback addresses unless explicitly allowed.

upstream veyra_api {
    server 127.0.0.1:@API_PORT@;
    keepalive 16;
}

limit_req_zone $binary_remote_addr zone=veyra_auth:10m rate=20r/m;
# Phones fetch four to six files in a burst at boot (docs/DEVICE_PROVISIONING.md §3.1).
limit_req_zone $binary_remote_addr zone=veyra_prov:10m rate=60r/m;

server {
@LISTEN_HTTP@
    # The HA service address, written by the HA agent (docs/HIGH_AVAILABILITY.md §2).
    include @VEYRA_ETC@/nginx-ha-listen-http.conf;
    server_name _;
    server_tokens off;
    # Plain HTTP only redirects to HTTPS. Phone provisioning over HTTP is
    # served below only when VEYRA_PROVISIONING_HTTP=1 (docs/DEVICE_PROVISIONING.md §3.3).
@HTTP_PROVISIONING@
    # ACME HTTP-01 challenges for a public certificate (docs/PUBLIC_CERTIFICATES.md §3).
    location ^~ /.well-known/acme-challenge/ {
        root @ACME_WEBROOT@;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 301 https://$host$request_uri; }
}

server {
@LISTEN_HTTPS@
    include @VEYRA_ETC@/nginx-ha-listen-https.conf;
    server_name _;

    ssl_certificate     @VEYRA_ETC@/tls/veyra.crt;
    ssl_certificate_key @VEYRA_ETC@/tls/veyra.key;
@HTTPS_SITE@}

# The public certificate (Let's Encrypt or another ACME authority) for its own
# names only; every other name and IP address gets the Veyra CA certificate
# above, which phones trust (docs/PUBLIC_CERTIFICATES.md §2). Until one is
# issued the name is public-certificate.invalid, which no request carries.
server {
@LISTEN_HTTPS@
    include @VEYRA_ETC@/nginx-ha-listen-https.conf;
    include @VEYRA_ETC@/nginx-public-name.conf;

    ssl_certificate     @VEYRA_ETC@/tls/public.crt;
    ssl_certificate_key @VEYRA_ETC@/tls/public.key;
@HTTPS_SITE@}
