# Managed by Veyra installer — changes are overwritten by install.sh/upgrade.sh.
# The administrative interface listens only on the addresses below, which the
# installer restricts to private/loopback addresses unless explicitly allowed.

upstream veyra_api {
    server 127.0.0.1:@API_PORT@;
    keepalive 16;
}

limit_req_zone $binary_remote_addr zone=veyra_auth:10m rate=20r/m;

server {
@LISTEN_HTTP@
    server_name _;
    server_tokens off;
    # Plain HTTP only redirects to HTTPS (phone provisioning over HTTP is a
    # separate, explicitly enabled server block in a later milestone).
    location / { return 301 https://$host$request_uri; }
}

server {
@LISTEN_HTTPS@
    server_name _;

    ssl_certificate     @VEYRA_ETC@/tls/veyra.crt;
    ssl_certificate_key @VEYRA_ETC@/tls/veyra.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:veyra_tls:10m;

    server_tokens off;
    client_max_body_size 25m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), geolocation=(), payment=()" always;
    # Next.js static export inlines its bootstrap scripts, hence 'unsafe-inline'
    # for scripts. No third-party origins are allowed.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    root @VEYRA_PREFIX@/current/frontend/out;
    index index.html;

    location /api/v1/auth/login {
        limit_req zone=veyra_auth burst=10 nodelay;
        proxy_pass http://veyra_api;
        include @VEYRA_ETC@/nginx-proxy.conf;
    }

    location /api/ {
        proxy_pass http://veyra_api;
        include @VEYRA_ETC@/nginx-proxy.conf;
    }

    location /_next/static/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    error_page 404 /404.html;

    location / {
        try_files $uri $uri/index.html $uri/ =404;
    }
}
