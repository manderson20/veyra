    # Provisioning over plain HTTP (opt-in: VEYRA_PROVISIONING_HTTP=1 in
    # /etc/veyra/installer.conf). By default the API answers here with the
    # phone trust bootstrap only (docs/FIREWALL_TRUST.md §6.3); with
    # VEYRA_PROVISIONING_HTTP_MODE=full it serves every file and SIP secrets
    # cross the network unencrypted.
    location /provisioning/firmware/ {
        alias @VEYRA_DATA@/firmware/;
        types { }
        default_type application/octet-stream;
        add_header Cache-Control "no-store";
    }
    location /provisioning/ {
        limit_req zone=veyra_prov burst=30 nodelay;
        client_max_body_size 8m;
        proxy_pass http://veyra_api;
        include @VEYRA_ETC@/nginx-proxy.conf;
    }
