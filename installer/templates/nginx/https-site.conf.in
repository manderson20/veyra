# Managed by Veyra installer — the body of both HTTPS servers in veyra.conf
# (rendered into each; docs/PUBLIC_CERTIFICATES.md §2).
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:veyra_tls:10m;

    server_tokens off;
    client_max_body_size 25m;

    include @VEYRA_ETC@/nginx-security-headers.conf;

    root @VEYRA_PREFIX@/current/frontend/out;
    index index.html;

    # Sign-in and password-reset endpoints share one per-address budget.
    location ~ ^/api/v1/auth/(login|mfa/verify|password-reset(/check|/request)?)$ {
        limit_req zone=veyra_auth burst=10 nodelay;
        proxy_pass http://veyra_api;
        include @VEYRA_ETC@/nginx-proxy.conf;
    }

    # Call-event streams (WebSocket): the Companion's (docs/COMPANION.md) and
    # the live views of the web interface (issue #111).
    # (nginx-proxy.conf is not included here: it sets its own Connection header
    # and read timeout, and NGINX refuses duplicate directives in one block.)
    location ~ ^/api/v1/events/(calls|staff)$ {
        proxy_pass http://veyra_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
        proxy_hide_header Cross-Origin-Opener-Policy;
    }

    # Uploads larger than the limit above, which also take longer to process:
    # firmware images and a FreePBX server's database dump and audio.
    # (nginx-proxy.conf is not included here: it sets its own read timeout.)
    location ~ ^/api/v1/(provisioning/firmware|bulk/freepbx/(convert|audio))$ {
        client_max_body_size 1g;
        proxy_pass http://veyra_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
        proxy_hide_header Cross-Origin-Opener-Policy;
    }

    location /api/ {
        proxy_pass http://veyra_api;
        include @VEYRA_ETC@/nginx-proxy.conf;
    }

    # Phone provisioning (docs/DEVICE_PROVISIONING.md §3): rendered files with
    # HTTP Basic authentication, and firmware images served from disk.
    location /provisioning/firmware/ {
        alias @VEYRA_DATA@/firmware/;
        types { }
        default_type application/octet-stream;
        include @VEYRA_ETC@/nginx-security-headers.conf;
        add_header Cache-Control "no-store";
    }
    location /provisioning/ {
        limit_req zone=veyra_prov burst=30 nodelay;
        client_max_body_size 8m;
        proxy_pass http://veyra_api;
        include @VEYRA_ETC@/nginx-proxy.conf;
    }

    # The Companion browser extension, packaged by the installer (docs/COMPANION.md).
    location = /downloads/veyra-companion.zip {
        alias @VEYRA_PREFIX@/current/companion/veyra-companion.zip;
        types { }
        default_type application/zip;
        include @VEYRA_ETC@/nginx-security-headers.conf;
        add_header Content-Disposition 'attachment; filename="veyra-companion.zip"';
    }

    location = /downloads/veyra-companion.crx {
        alias @VEYRA_PREFIX@/current/companion/veyra-companion.crx;
        types { }
        default_type application/x-chrome-extension;
    }

    # The Veyra CA certificate (docs/FIREWALL_TRUST.md §6.2): install it in
    # browsers (or push it with Google Admin) to trust this server.
    location = /downloads/veyra-ca.crt {
        alias @VEYRA_PREFIX@/veyra-ca.crt;
        types { }
        default_type application/x-x509-ca-cert;
        include @VEYRA_ETC@/nginx-security-headers.conf;
        add_header Content-Disposition 'attachment; filename="veyra-ca.crt"';
    }

    # NGINX's mime.types has no entry for the web manifest.
    location = /manifest.webmanifest {
        types { }
        default_type application/manifest+json;
        try_files $uri =404;
    }

    location /_next/static/ {
        include @VEYRA_ETC@/nginx-security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    error_page 404 /404.html;

    location / {
        try_files $uri $uri/index.html $uri/ =404;
    }
