# Veyra voicemail store helper (docs/USER_PORTAL.md §2.2): reads and writes
# Asterisk's voicemail spool for the web inbox and greetings. Runs as the
# asterisk user because the spool belongs to it; the API (veyra) talks to it
# over /run/veyra/vmstore.sock (asterisk:veyra 0660) with a fixed list of
# verbs on validated paths under the spool. It never touches the network.
[Unit]
Description=Veyra voicemail store helper
Documentation=file://@VEYRA_PREFIX@/current/docs/USER_PORTAL.md
After=asterisk.service
Wants=asterisk.service

[Service]
Type=exec
User=asterisk
Group=veyra
EnvironmentFile=@VEYRA_ETC@/veyra.env
WorkingDirectory=@VEYRA_PREFIX@/current/backend
ExecStart=@VEYRA_PREFIX@/current/backend/.venv/bin/veyra vmstore serve
Restart=always
RestartSec=3
RuntimeDirectory=veyra
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/spool/asterisk/voicemail /run/veyra
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
