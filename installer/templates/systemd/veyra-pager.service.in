# Managed by Veyra installer
[Unit]
Description=Veyra page sender (multicast speakers and Poly phones in step)
Documentation=file://@VEYRA_PREFIX@/current/docs/PAGING_RECORDINGS.md
After=network-online.target asterisk.service
Wants=network-online.target

[Service]
Type=exec
User=veyra
Group=veyra
EnvironmentFile=@VEYRA_ETC@/veyra.env
WorkingDirectory=@VEYRA_PREFIX@/current/backend
ExecStart=@VEYRA_PREFIX@/current/backend/.venv/bin/veyra pager
Restart=on-failure
RestartSec=3
UMask=0027

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=@VEYRA_LOG_DIR@

[Install]
WantedBy=multi-user.target
