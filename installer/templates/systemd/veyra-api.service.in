# Managed by Veyra installer
[Unit]
Description=Veyra management API
Documentation=file://@VEYRA_PREFIX@/current/docs/ARCHITECTURE.md
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=exec
User=veyra
Group=veyra
EnvironmentFile=@VEYRA_ETC@/veyra.env
WorkingDirectory=@VEYRA_PREFIX@/current/backend
# Single process: module enable/disable is applied in-process (see docs/ARCHITECTURE.md).
ExecStart=@VEYRA_PREFIX@/current/backend/.venv/bin/uvicorn veyra.main:create_app --factory --host 127.0.0.1 --port @API_PORT@ --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header
Restart=on-failure
RestartSec=3
UMask=0027

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=@VEYRA_DATA@ @VEYRA_LOG_DIR@

[Install]
WantedBy=multi-user.target
