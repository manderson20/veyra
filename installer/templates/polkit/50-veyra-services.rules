// Managed by Veyra installer
// The veyra service account may restart Veyra's own services, and nothing
// else, so new module code can take effect from the web interface
// (docs/MODULE_CATALOG.md §4), and start an approved upgrade
// (veyra-upgrade@<version>.service, docs/SOFTWARE_UPDATES.md §3.2), which
// verifies the release itself. Asterisk and the rest of the system are
// unaffected.
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units" || subject.user !== "veyra") {
        return polkit.Result.NOT_HANDLED;
    }
    var units = ["veyra-api.service", "veyra-worker.service", "veyra-deployer.service",
                 "veyra-pager.service", "veyra-firewall.service"];
    var unit = action.lookup("unit"), verb = action.lookup("verb");
    if (units.indexOf(unit) >= 0 && verb === "restart") {
        return polkit.Result.YES;
    }
    if (/^veyra-upgrade@[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?\.service$/.test(unit) && verb === "start") {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
