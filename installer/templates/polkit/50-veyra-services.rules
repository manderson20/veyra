// Managed by Veyra installer
// The veyra service account may restart Veyra's own services, and nothing
// else, so new module code can take effect from the web interface
// (docs/MODULE_CATALOG.md §4), and start an approved upgrade
// (veyra-upgrade@<version>.service, docs/SOFTWARE_UPDATES.md §3.2), which
// verifies the release itself. Asterisk and the rest of the system are
// unaffected.
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units" || subject.user !== "veyra") {
        return polkit.Result.NOT_HANDLED;
    }
    var units = ["veyra-api.service", "veyra-worker.service", "veyra-deployer.service",
                 "veyra-pager.service", "veyra-firewall.service", "veyra-ha-agent.service"];
    var unit = action.lookup("unit"), verb = action.lookup("verb");
    if (units.indexOf(unit) >= 0 && verb === "restart") {
        return polkit.Result.YES;
    }
    if (/^veyra-upgrade@[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?\.service$/.test(unit) && verb === "start") {
        return polkit.Result.YES;
    }
    // Backups (docs/PRODUCTION_HARDENING.md §2.2): run, run-manual, delete-<uuid>,
    // download-<uuid>, download-clean and restore-<uuid> (only from a backup in root's own store).
    if (/^veyra-backup@(run|run-manual|recordings|download-clean|(delete|download|restore)-[0-9a-f-]{36})\.service$/.test(unit) && verb === "start") {
        return polkit.Result.YES;
    }
    // Installation key rotation (issue #125; docs/PRODUCTION_HARDENING.md §3.1).
    if (unit === "veyra-key-rotate.service" && verb === "start") {
        return polkit.Result.YES;
    }
    // Operating system packages from the Updates page (docs/SOFTWARE_UPDATES.md §6).
    if (/^veyra-os-packages@(refresh|security|all|everything|telephony)\.service$/.test(unit) && verb === "start") {
        return polkit.Result.YES;
    }
    // Public HTTPS certificates (docs/PUBLIC_CERTIFICATES.md): issue, renew, remove.
    if (/^veyra-acme@(issue|renew|remove)\.service$/.test(unit) && verb === "start") {
        return polkit.Result.YES;
    }
    // Packet captures (docs/CALL_FEATURES.md §2.2): one unit per recorded capture, start and stop.
    if (/^veyra-capture@[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\.service$/.test(unit) && (verb === "start" || verb === "stop")) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
