# Managed by Veyra installer. Values here are read by veyra-api, veyra-worker
# and the `veyra` command. Secrets are kept in @VEYRA_ETC@/secrets, not here.
VEYRA_ENVIRONMENT=production
# Peer authentication over the local PostgreSQL socket: no password is stored.
VEYRA_DATABASE_URL=postgresql+psycopg:///@DB_NAME@?host=/run/postgresql
VEYRA_CONFIG_DIR=@VEYRA_ETC@
VEYRA_DATA_DIR=@VEYRA_DATA@
VEYRA_LOG_DIR=@VEYRA_LOG_DIR@
VEYRA_MODULE_PATHS=@VEYRA_PREFIX@/current/modules:@VEYRA_DATA@/modules
VEYRA_TEMPLATE_PATHS=@VEYRA_PREFIX@/current/provisioning/templates:@VEYRA_DATA@/provisioning/templates
VEYRA_COOKIE_SECURE=true
VEYRA_TRUSTED_PROXY_COUNT=1
VEYRA_TELEPHONY_ENGINE=@TELEPHONY_ENGINE@
VEYRA_ASTERISK_ARI_URL=http://127.0.0.1:8088/ari
VEYRA_ASTERISK_ARI_USERNAME=veyra
VEYRA_ASTERISK_ARI_PASSWORD_FILE=@VEYRA_ETC@/secrets/ari_password
# Update metadata source (empty = update checks report "not configured").
VEYRA_UPDATE_METADATA_URL=
