#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# Asterisk's voicemail "mailcmd": the composed notification (headers, body,
# attachment) arrives on standard input and is written into Veyra's mail
# queue, which the worker (veyra worker) delivers through the configured
# SMTP server (docs/VOICEMAIL_IVR.md §2). No mail transport is needed on the
# server and the message never passes through the API process.
#
# Usage: veyra-mailqueue [QUEUE_DIR]   (default /var/lib/veyra/mailqueue)
# Runs as the asterisk user; the queue directory is 2770 veyra:asterisk.
set -eu
dir="${1:-${VEYRA_MAILQUEUE_DIR:-/var/lib/veyra/mailqueue}}"
[ -d "$dir" ] || { echo "veyra-mailqueue: $dir does not exist" >&2; exit 1; }
umask 007
name="$(date -u +%Y%m%dT%H%M%S)-$$-$(od -An -N4 -tx4 /dev/urandom 2>/dev/null | tr -d ' \n')"
tmp="$dir/.$name.tmp"
cat >"$tmp"
if [ ! -s "$tmp" ]; then
    rm -f "$tmp"
    echo "veyra-mailqueue: empty message, nothing queued" >&2
    exit 1
fi
# A voicemail notification names its message in the body
# ("[veyra-vm:<spool>/<context>/<mailbox>/<folder>/msgNNNN]", emailbody in
# voicemail.conf). Its msg_id is read now, while the number is still right,
# and put in a header: the worker deletes that message once the email has
# been accepted, if the box asks for it (issue #148), and strips both.
ref="$(sed -n 's/^.*\[veyra-vm:\([^]]*\)\].*$/\1/p' "$tmp" | head -n 1)"
case "$ref" in
    */voicemail/*/*/*/msg[0-9][0-9][0-9][0-9])
        box="${ref%/*/*}"
        mailbox="${box##*/}"
        context="${box%/*}"
        context="${context##*/}"
        msg_id="$(sed -n 's/^msg_id=//p' "$ref.txt" 2>/dev/null | head -n 1 | tr -cd 'A-Za-z0-9_.-')"
        if [ -n "$msg_id" ] && printf '%s' "$mailbox" | grep -Eq '^[0-9]{1,16}$' &&
            printf '%s' "$context" | grep -Eq '^[a-z0-9_][a-z0-9_-]{0,63}$'; then
            { printf 'X-Veyra-Voicemail: context=%s; mailbox=%s; msg_id=%s\n' \
                "$context" "$mailbox" "$msg_id"; cat "$tmp"; } >"$tmp.h"
            mv -f "$tmp.h" "$tmp"
        fi
        ;;
esac
chmod 0660 "$tmp"
mv -f "$tmp" "$dir/$name.eml"
