#!version:1.0.0.1
## Generated by Veyra for {{ model }} {{ mac }}{% if device.label %} ({{ device.label | replace("\n", " ") }}){% endif %}. Do not edit.
{%- macro c(v) %}{{ (v ~ "") | replace("\n", " ") | replace("\r", " ") }}{% endmacro %}
{%- set tr = {"UDPOnly": 0, "TCPOnly": 1, "TLS": 2, "DNSnaptr": 3}[sip_transport] %}
{% block registration %}
{% for line in lines %}
account.{{ line.index }}.enable = 1
account.{{ line.index }}.label = {{ c(line.label or line.extension_number) }}
account.{{ line.index }}.display_name = {{ c(line.caller_id_name or line.display_name or line.extension_number) }}
account.{{ line.index }}.auth_name = {{ line.sip_username }}
account.{{ line.index }}.user_name = {{ line.sip_username }}
account.{{ line.index }}.password = {{ line.sip_password }}
account.{{ line.index }}.sip_server.1.address = {{ server.sip_host }}
account.{{ line.index }}.sip_server.1.port = {{ server.sip_port }}
account.{{ line.index }}.sip_server.1.transport_type = {{ tr }}
account.{{ line.index }}.sip_server.1.expires = {{ registration_expires }}
account.{{ line.index }}.srtp_encryption = {{ {"off": 0, "optional": 1, "required": 2}[server.srtp] }}
{% if line.voicemail %}
account.{{ line.index }}.subscribe_mwi = 1
account.{{ line.index }}.subscribe_mwi_to_vm = 1
voice_mail.number.{{ line.index }} = {{ server.voicemail_number }}
{% endif %}
{% endfor %}
{% if not lines %}
## No extension assigned: nothing registers.
{% endif %}
{% endblock %}
{% block keys %}
features.pickup.direct_pickup_enable = 1
features.pickup.direct_pickup_code = {{ server.pickup_prefix }}
{% for key in keys %}
{% set n = key.index %}
{% if key.type == "line" %}
linekey.{{ n }}.type = 15
linekey.{{ n }}.line = {{ key.value }}
linekey.{{ n }}.label = {{ c(key.label) }}
{% elif key.type == "blf" %}
linekey.{{ n }}.type = 16
linekey.{{ n }}.value = {{ key.value }}
linekey.{{ n }}.line = 1
linekey.{{ n }}.extension = {{ server.pickup_prefix }}
linekey.{{ n }}.label = {{ c(key.label) }}
{% elif key.type == "speed_dial" %}
linekey.{{ n }}.type = 13
linekey.{{ n }}.value = {{ key.value }}
linekey.{{ n }}.line = 1
linekey.{{ n }}.label = {{ c(key.label) }}
{% elif key.type == "transfer" %}
linekey.{{ n }}.type = 3
linekey.{{ n }}.label = {{ c(key.label) }}
{% elif key.type == "page" and key.multicast_address %}
linekey.{{ n }}.type = 24
linekey.{{ n }}.value = {{ key.multicast_address }}:{{ key.multicast_port }}
linekey.{{ n }}.label = {{ c(key.label) }}
{% endif %}
{% endfor %}
{% endblock %}
{% block paging %}
{% if paging.enabled %}
multicast.codec = {{ "G722" if paging.codec == "G.722" else "PCMU" }}
{% for g in paging.groups if g.subscribed %}
{% if loop.index <= 10 %}
multicast.listen_address.{{ loop.index }}.ip_address = {{ g.multicast_address }}:{{ g.multicast_port }}
multicast.listen_address.{{ loop.index }}.label = {{ c(g.label) }}
{% endif %}
{% endfor %}
{% endif %}
{% endblock %}
{% block time %}
local_time.ntp_server1 = {{ server.ntp_server }}
{%- set off = server.dst.standard_offset %}
{%- set a = off if off >= 0 else -off %}
local_time.time_zone = {{ "-" if off < 0 else "+" }}{{ a // 3600 }}{% if a % 3600 %}:{{ "%02d" | format((a % 3600) // 60) }}{% endif %}
{% if server.dst.enabled %}
{%- set s = server.dst.start %}{% set e = server.dst.stop %}
local_time.summer_time = 1
local_time.dst_time_type = 1
local_time.start_time = {{ s.month }}/{{ s.week }}/{{ ((s.day_of_week + 5) % 7) + 1 }}/{{ s.hour }}
local_time.end_time = {{ e.month }}/{{ e.week }}/{{ ((e.day_of_week + 5) % 7) + 1 }}/{{ e.hour }}
local_time.offset_time = 60
{% else %}
local_time.summer_time = 0
{% endif %}
{% endblock %}
{% block provisioning %}
auto_provision.server.url = {{ server.provisioning_url }}
{% if device.credential_user %}
auto_provision.server.username = {{ device.credential_user }}
auto_provision.server.password = {{ device.credential_password }}
{% endif %}
auto_provision.weekly.enable = 1
auto_provision.weekly.dayofweek = 0123456
auto_provision.weekly.begin_time = {{ "%02d" | format(polling_hour % 24) }}:00
auto_provision.weekly.end_time = {{ "%02d" | format((polling_hour + 2) % 24) }}:00
sip.notify_reboot_enable = 1
{% if server.firmware_url %}
static.firmware.url = {{ server.firmware_url }}
{% endif %}
{% if vlan_id %}
static.network.vlan.internet_port_enable = 1
static.network.vlan.internet_port_vid = {{ vlan_id }}
{% endif %}
{% if admin_password %}
static.security.user_password = admin:{{ admin_password }}
{% endif %}
{% if directory_enabled %}
remote_phonebook.data.1.url = {{ server.directory_url }}yealink.xml
remote_phonebook.data.1.name = {{ c(organization.name) }}
{% if device.credential_user %}
remote_phonebook.data.1.username = {{ device.credential_user }}
remote_phonebook.data.1.password = {{ device.credential_password }}
{% endif %}
features.remote_phonebook.enable = 1
{% endif %}
{% endblock %}
{% block hotline %}
## Hotline (issue #168): lifting the handset dials the first line's hotline
## number, at once or after the delay without a digit (warm line).
{% set hl = lines[0] if lines else None %}
{% if hl and hl.get("hotline") %}
features.hotline_number = {{ c(hl.hotline) }}
features.hotline_delay = {{ hl.get("hotline_delay", 0) }}
{% else %}
features.hotline_number =
{% endif %}
{% endblock %}
{% block intercom %}
## Intercom (docs/CALL_FEATURES.md §3.6): Veyra's intercom calls carry
## Call-Info answer-after=0, answered on the speaker.
features.intercom.allow = {{ intercom_auto_answer | bool01 }}
features.intercom.mute = {{ intercom_mic_muted | bool01 }}
features.intercom.tone = 1
features.intercom.barge = 0
{% endblock %}
{% block model_settings %}{% endblock %}
