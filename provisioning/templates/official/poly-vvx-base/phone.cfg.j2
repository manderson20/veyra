<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Generated by Veyra for {{ model }} {{ mac }}{% if device.label %} ({{ device.label }}){% endif %}. Do not edit. -->
<polycomConfig>
{% block registration %}
  <sec
    sec.srtp.enable="{{ 0 if server.srtp == "off" else 1 }}"
    sec.srtp.offer="{{ 0 if server.srtp == "off" else 1 }}"
    sec.srtp.require="{{ 1 if server.srtp == "required" else 0 }}" />
{% for line in lines %}
  <reg
    reg.{{ line.index }}.address="{{ line.sip_username }}"
    reg.{{ line.index }}.auth.userId="{{ line.sip_username }}"
    reg.{{ line.index }}.auth.password="{{ line.sip_password }}"
    reg.{{ line.index }}.displayName="{{ line.caller_id_name or line.display_name or line.extension_number }}"
    reg.{{ line.index }}.label="{{ line.label or line.extension_number }}"
    reg.{{ line.index }}.server.1.address="{{ server.sip_host }}"
    reg.{{ line.index }}.server.1.port="{{ server.sip_port }}"
    reg.{{ line.index }}.server.1.transport="{{ sip_transport }}"
    reg.{{ line.index }}.server.1.expires="{{ registration_expires }}"
    reg.{{ line.index }}.lineKeys="1" />
{% endfor %}
{% if not lines %}
  <!-- No extension assigned: nothing registers. -->
{% endif %}
{% endblock %}
{% block voicemail %}
{% for line in lines if line.voicemail %}
  <msg
    msg.mwi.{{ line.index }}.subscribe="{{ line.sip_username }}"
    msg.mwi.{{ line.index }}.callBackMode="contact"
    msg.mwi.{{ line.index }}.callBack="{{ server.voicemail_number }}" />
{% endfor %}
{% endblock %}
{% block keys %}
{% if keys %}
  <feature feature.enhancedFeatureKeys.enabled="1" />
  <call
    call.directedCallPickupMethod="native"
    call.directedCallPickupString="{{ server.pickup_prefix }}" />
{% for key in keys %}
{% if key.type == "line" %}
  <lineKey lineKey.{{ key.index }}.category="Line" lineKey.{{ key.index }}.index="{{ key.value }}" />
{% elif key.type == "blf" %}
  <lineKey lineKey.{{ key.index }}.category="BLF" lineKey.{{ key.index }}.index="{{ key.blf_index }}" />
  <attendant
    attendant.resourceList.{{ key.blf_index }}.address="{{ key.value }}"
    attendant.resourceList.{{ key.blf_index }}.label="{{ key.label }}"
    attendant.resourceList.{{ key.blf_index }}.type="normal" />
{% elif key.type == "speed_dial" %}
  <lineKey lineKey.{{ key.index }}.category="SpeedDial" lineKey.{{ key.index }}.index="{{ key.speed_dial_index }}" />
  <efk
    efk.efklist.{{ key.speed_dial_index }}.mname="veyra-sd-{{ key.speed_dial_index }}"
    efk.efklist.{{ key.speed_dial_index }}.status="1"
    efk.efklist.{{ key.speed_dial_index }}.label="{{ key.label }}"
    efk.efklist.{{ key.speed_dial_index }}.action.string="{{ key.value }}$Tinvite$" />
{% elif key.type == "page" %}
  <lineKey lineKey.{{ key.index }}.category="Paging" lineKey.{{ key.index }}.index="{{ key.group }}" />
{% endif %}
{% endfor %}
  <attendant attendant.behaviors.display.spontaneousCallAppearances.normal="0" />
{% endif %}
{% endblock %}
{% block paging %}
{% if paging.enabled %}
  <ptt
    ptt.pageMode.enable="1"
    ptt.address="{{ paging.address }}"
    ptt.port="{{ paging.port }}"
    ptt.pageMode.codec="{{ paging.codec }}"
    ptt.pageMode.displayName="{{ device.label or (lines[0].display_name if lines else '') }}"
    ptt.pageMode.defaultGroup="{{ paging.default_group or '' }}"
    ptt.pageMode.priorityGroup="{{ paging.priority_group or '' }}"
    ptt.pageMode.emergencyGroup="{{ paging.emergency_group or '' }}"
    ptt.pageMode.payloadSize="20"
    ptt.volume="{{ paging_default_volume }}" />
{% for group in paging.groups %}
  <ptt
    ptt.pageMode.group.{{ group.number }}.label="{{ group.label }}"
    ptt.pageMode.group.{{ group.number }}.subscribed="{{ group.subscribed | bool01 }}"
    ptt.pageMode.group.{{ group.number }}.allowTransmit="{{ group.transmit | bool01 }}"
    ptt.pageMode.group.{{ group.number }}.allowReceive="{{ group.subscribed | bool01 }}" />
{% endfor %}
{% else %}
  <ptt ptt.pageMode.enable="0" />
{% endif %}
{% endblock %}
{% block time %}
  <tcpIpApp
    tcpIpApp.sntp.address="{{ server.ntp_server }}"
    tcpIpApp.sntp.gmtOffset="{{ server.dst.standard_offset }}"
    tcpIpApp.sntp.daylightSavings.enable="{{ server.dst.enabled | bool01 }}"
{% if server.dst.enabled %}
    tcpIpApp.sntp.daylightSavings.fixedDayEnable="0"
    tcpIpApp.sntp.daylightSavings.start.month="{{ server.dst.start.month }}"
    tcpIpApp.sntp.daylightSavings.start.date="{{ server.dst.start.date }}"
    tcpIpApp.sntp.daylightSavings.start.dayOfWeek="{{ server.dst.start.day_of_week }}"
    tcpIpApp.sntp.daylightSavings.start.dayOfWeek.lastInMonth="{{ server.dst.start.last_in_month | bool01 }}"
    tcpIpApp.sntp.daylightSavings.start.time="{{ server.dst.start.hour }}"
    tcpIpApp.sntp.daylightSavings.stop.month="{{ server.dst.stop.month }}"
    tcpIpApp.sntp.daylightSavings.stop.date="{{ server.dst.stop.date }}"
    tcpIpApp.sntp.daylightSavings.stop.dayOfWeek="{{ server.dst.stop.day_of_week }}"
    tcpIpApp.sntp.daylightSavings.stop.dayOfWeek.lastInMonth="{{ server.dst.stop.last_in_month | bool01 }}"
    tcpIpApp.sntp.daylightSavings.stop.time="{{ server.dst.stop.hour }}"
{% endif %}
    />
{% endblock %}
{% block network %}
{% if vlan_id %}
  <device device.set="1" device.net.vlanId.set="1" device.net.vlanId="{{ vlan_id }}" />
{% endif %}
{% endblock %}
{% block provisioning %}
{% if device.credential_user %}
  <device device.set="1"
    device.prov.user.set="1" device.prov.user="{{ device.credential_user }}"
    device.prov.password.set="1" device.prov.password="{{ device.credential_password }}"
    device.prov.serverName.set="1" device.prov.serverName="{{ server.provisioning_url }}"
    device.prov.serverType.set="1" device.prov.serverType="{{ server.provisioning_server_type }}" />
{% endif %}
  <prov
    prov.polling.enabled="1"
    prov.polling.mode="abs"
    prov.polling.period="86400"
    prov.polling.time="{{ '%02d' % polling_hour }}:00" />
{% if admin_password %}
  <device device.set="1" device.auth.localAdminPassword.set="1" device.auth.localAdminPassword="{{ admin_password }}" />
{% endif %}
{% endblock %}
{% block display %}
  <up
    up.backlight.idleIntensity="{{ backlight_idle }}"
    up.screenSaver.enable="{{ (screen_saver_minutes > 0) | bool01 }}"
    up.screenSaver.waitTime="{{ screen_saver_minutes if screen_saver_minutes > 0 else 10 }}" />
{% endblock %}
{% block hotline %}
{% for line in lines if line.get("hotline") %}
  <!-- Hotline (issue #168): lifting the handset on this line dials the
       number at once; Poly has no warm-line delay, so a delay is ignored. -->
  <call
    call.autoOffHook.{{ line.index }}.enabled="1"
    call.autoOffHook.{{ line.index }}.contact="{{ line.hotline }}"
    call.autoOffHook.{{ line.index }}.protocol="SIP" />
{% endfor %}
{% endblock %}
{% block intercom %}
{% if intercom_auto_answer %}
  <!-- Intercom (docs/CALL_FEATURES.md §3.6): Veyra's intercom calls carry
       Alert-Info ...;info=alert-autoanswer, answered on the speaker. -->
  <voIpProt voIpProt.SIP.alertInfo.1.value="alert-autoanswer" voIpProt.SIP.alertInfo.1.class="autoAnswer" />
  <se se.rt.autoAnswer.type="ring-answer" />
  <call call.autoAnswer.micMute="{{ intercom_mic_muted | bool01 }}" />
{% endif %}
{% endblock %}
{% block model_settings %}{% endblock %}
</polycomConfig>
