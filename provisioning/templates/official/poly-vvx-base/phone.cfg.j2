<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Generated by Veyra for {{ model }} {{ mac }}. Do not edit. -->
<polycomConfig>
{% block registration %}
  <reg
    reg.1.address="{{ sip_username }}"
    reg.1.auth.userId="{{ sip_username }}"
    reg.1.auth.password="{{ sip_password }}"
    reg.1.displayName="{{ caller_id or display_name or extension_number }}"
    reg.1.label="{{ display_name or extension_number }}"
    reg.1.server.1.address="{{ sip_server }}"
    reg.1.server.1.port="{{ sip_port }}"
    reg.1.server.1.transport="{{ sip_transport }}"
    reg.1.server.1.expires="{{ registration_expires }}" />
{% endblock %}
{% block time %}
  <!-- Fixed UTC offset computed when this file was generated (DST rules: see template docs). -->
  <tcpIpApp
    tcpIpApp.sntp.address="{{ ntp_server }}"
    tcpIpApp.sntp.gmtOffset="{{ timezone | utc_offset_seconds }}"
    tcpIpApp.sntp.daylightSavings.enable="0" />
{% endblock %}
{% block network %}
{% if vlan_id %}
  <device device.set="1" device.net.vlanId.set="1" device.net.vlanId="{{ vlan_id }}" />
{% endif %}
{% endblock %}
{% block model_settings %}{% endblock %}
</polycomConfig>
