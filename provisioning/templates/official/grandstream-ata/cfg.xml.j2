<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by Veyra for {{ model }} {{ mac }}{% if device.label %} ({{ device.label | replace("\n", " ") | replace("--", "- -") }}){% endif %}. Do not edit. -->
{#- P-values from Grandstream's configuration templates: HT80x 1.0.65.3,
    HT80x v2 1.0.15.2, HT81x and HT818 1.0.65.3, HT81x v2 1.0.15.2. -#}
{%- macro p(n, v) %}<P{{ n }}>{{ (v ~ "") | replace("\r", " ") }}</P{{ n }}>{% endmacro %}
{%- macro c(v) %}{{ (v ~ "") | replace("\n", " ") | replace("\r", " ") }}{% endmacro %}
{%- set m = model | upper | replace("-", "") %}
{%- set fam = "ht81x" if m.startswith("HT81") else "ht80x" %}
{%- set ports = {"HT801": 1, "HT802": 2, "HT812": 2, "HT814": 4, "HT818": 8}.get(m[:5], 1) %}
{%- set tr = {"UDPOnly": 0, "TCPOnly": 1, "TLS": 2, "DNSnaptr": 0}[sip_transport] %}
{%- set https = server.provisioning_server_type == "HTTPS" %}
{%- set server_address = server.sip_host ~ ("" if server.sip_port == 5060 else ":" ~ server.sip_port) %}
{#- Port 1 and port 2 of the HT80x, or profile 1 and profile 2 of the HT81x:
    the same settings under two sets of P-values. -#}
{%- set S = {
  "active": [271, 401],
  "server": [47, 747],
  "transport": [130, 830],
  "expires": [32, 732],
  "mwi": [99, 709],
  "local_features": [191, 751],
  "autodial_delay": [4045, 4046],
  "fax_mode": [228, 710],
  "fax_reinvite": [4416, 4417],
  "vocoders": [[57, 58, 59, 60, 61, 62, 46, 98], [757, 758, 759, 760, 761, 762, 814, 815]],
  "vad": [50, 750],
  "visual_mwi": [855, 869],
} %}
{%- macro common(i, fax_t38, autodial_delay, mwi) %}
{{ p(S.active[i], 1) }}
{{ p(S.server[i], server_address) }}
{{ p(S.transport[i], tr) }}
{{ p(S.expires[i], [registration_expires // 60, 1] | max) }}
{{ p(S.mwi[i], mwi | bool01) }}
{{ p(S.visual_mwi[i], 0) }}
{{ p(S.local_features[i], local_call_features | bool01) }}
{{ p(S.autodial_delay[i], autodial_delay) }}
<!-- Fax: {{ "T.38 (the extension offers T.38)" if fax_t38 else "G.711 pass-through" }}; the ATA switches when it hears the fax tone. -->
{{ p(S.fax_mode[i], 0 if fax_t38 else 1) }}
{{ p(S.fax_reinvite[i], 1) }}
{{ p(S.vad[i], 0) }}
{#- G.711 first: pass-through fax and modems need it. -#}
{% for v in [0, 8, 9, 18, 4, 2, 97, 123] %}
{{ p(S.vocoders[i][loop.index0], v) }}
{% endfor %}
{%- endmacro %}
<gs_provision version="1">
<mac>{{ mac }}</mac>
<config version="1">
{% block ports %}
{% set used = lines | selectattr("index", "le", ports) | list %}
{% if fam == "ht80x" %}
{#- Port n: its own account. -#}
{% set A = {
  "user": [35, 735],
  "auth": [36, 736],
  "password": [34, 734],
  "name": [3, 703],
  "autodial": [71, 771],
} %}
{% for line in used %}
{% set i = line.index - 1 %}
<!-- Port {{ line.index }}: {{ c(line.extension_number) }} -->
{{ p(A.user[i], line.sip_username) }}
{{ p(A.auth[i], line.sip_username) }}
{{ p(A.password[i], line.sip_password) }}
{{ p(A.name[i], c(line.caller_id_name or line.display_name or line.extension_number)) }}
{{ p(A.autodial[i], c(line.get("hotline") or "")) }}
{#- A fax machine (T.38) extension gets T.38; every other port pass-through. -#}
{{ common(i, fax_mode == "t38" or (fax_mode == "auto" and line.get("fax_t38", false)), line.get("hotline_delay", 0) if line.get("hotline") else 0, line.voicemail) }}
{% endfor %}
{% else %}
{#- Ports share a profile: profile 1 pass-through, profile 2 T.38 for the
    fax machine (T.38) ports. Each port has its own credentials. -#}
{% set hot = used | selectattr("hotline") | list %}
{% set fax_ports = used | selectattr("fax_t38") | list %}
{% set mwi = used | selectattr("voicemail") | list | length > 0 %}
{#- One warm-line delay for the profile: the first hotline port's. -#}
{% set delay = hot[0].hotline_delay if hot else 0 %}
<!-- Profile 1: {{ "T.38 on every port" if fax_mode == "t38" else "G.711 pass-through" }} -->
{{ common(0, fax_mode == "t38", delay, mwi) }}
{% if fax_mode == "auto" and fax_ports %}
<!-- Profile 2: the fax machine (T.38) ports -->
{{ common(1, true, delay, mwi) }}
{% else %}
{{ p(S.active[1], 0) }}
{% endif %}
{% for n in [1, 2, 3, 4, 5, 6, 7, 8] %}
{% set at = used | selectattr("index", "eq", n) | list %}
{% set line = at[0] if at else none %}
{% set i = n - 1 %}
{% if line %}
<!-- Port {{ n }}: {{ c(line.extension_number) }} -->
{{ p(4060 + i, line.sip_username) }}
{{ p(4090 + i, line.sip_username) }}
{{ p(4120 + i, line.sip_password) }}
{{ p(4180 + i, c(line.caller_id_name or line.display_name or line.extension_number)) }}
{{ p(4150 + i, 1 if (fax_mode == "auto" and line.get("fax_t38", false)) else 0) }}
{{ p(4595 + i, 1) }}
{{ p(4210 + i, c(line.get("hotline") or "")) }}
{% elif n <= ports %}
<!-- Port {{ n }}: no extension -->
{{ p(4595 + i, 0) }}
{% endif %}
{% endfor %}
{% endif %}
{% if not used %}
<!-- No extension assigned: nothing registers. -->
{% endif %}
{% for line in lines if line.index > ports %}
<!-- Line {{ line.index }} ({{ c(line.extension_number) }}) is not used: the {{ model }} has {{ ports }} port{{ "s" if ports > 1 else "" }}. -->
{% endfor %}
{% endblock %}
{% block time %}
<!-- Time: the zone and daylight saving as a POSIX rule, so DHCP cannot change them. -->
{{ p(30, server.ntp_server) }}
{{ p(144, 0) }}
{{ p(143, 0) }}
{%- set off = server.dst.standard_offset %}
{%- macro posix(name, seconds) %}{% set a = seconds if seconds >= 0 else -seconds %}{{ name }}{{ "-" if seconds > 0 else "+" }}{{ a // 3600 }}{% if a % 3600 %}:{{ "%02d" | format((a % 3600) // 60) }}{% endif %}{% endmacro %}
{%- macro rule(r) %}M{{ r.month }}.{{ r.week }}.{{ r.day_of_week - 1 }}{% if r.hour != 2 %}/{{ r.hour }}{% endif %}{% endmacro %}
{{ p(64, "customize") }}
{% if server.dst.enabled %}
{{ p(246, posix("MTZ", off) ~ posix("MDT", off + 3600) ~ "," ~ rule(server.dst.start) ~ "," ~ rule(server.dst.stop)) }}
{% else %}
{{ p(246, posix("MTZ", off)) }}
{% endif %}
{% endblock %}
{% block provisioning %}
<!-- Provisioning: this server, the device credential, a daily check. -->
{{ p(212, 2 if https else 1) }}
{{ p(237, server.host ~ "/" ~ server.provisioning_path) }}
{% if device.credential_user %}
{{ p(1360, device.credential_user) }}
{{ p(1361, device.credential_password) }}
{{ p(20713, 1) }}
{% endif %}
{{ p(145, dhcp_override | bool01) }}
{{ p(22296, 2) }}
{{ p(285, polling_hour % 24) }}
<!-- SIP NOTIFY check-sync from Veyra needs no authentication. -->
{{ p(4428, 1) }}
{% if server.firmware_url %}
{% set fw = server.firmware_url.split("://", 1)[1] %}
{{ p(6767, 2 if server.firmware_url.startswith("https") else 1) }}
{{ p(192, fw.rsplit("/", 1)[0]) }}
{{ p(238, 0) }}
{% else %}
<!-- No firmware assigned: the ATA does not upgrade itself from Grandstream's server. -->
{{ p(238, 2) }}
{% endif %}
{% if install_ca and server.ca_certificate %}
{{ p(2386, server.ca_certificate) }}
{{ p(8502, 2) }}
{% endif %}
{{ p(8463, validate_server_certificate | bool01) }}
{% if vlan_id %}
{{ p(22174, 1) }}
{{ p(51, vlan_id) }}
{% endif %}
{% if admin_password %}
{{ p(2, admin_password) }}
{% endif %}
{% endblock %}
{% block model_settings %}{% endblock %}
</config>
</gs_provision>
