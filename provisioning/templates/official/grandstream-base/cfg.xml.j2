<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by Veyra for {{ model }} {{ mac }}{% if device.label %} ({{ device.label | replace("\n", " ") | replace("--", "- -") }}){% endif %}. Do not edit. -->
{#- P-values from Grandstream's configuration templates: GRP261x 1.0.15.8,
    GRP260x 1.0.7.71, GXP2130/40/60/70/35 1.0.11.106. -#}
{%- macro p(n, v) %}<P{{ n }}>{{ (v ~ "") | replace("\r", " ") }}</P{{ n }}>{% endmacro %}
{%- macro c(v) %}{{ (v ~ "") | replace("\n", " ") | replace("\r", " ") }}{% endmacro %}
{%- set fam = "gxp" if model.startswith("GXP") else ("grp260x" if model.startswith("GRP260") else "grp261x") %}
{%- set max_accounts = 4 if fam == "grp260x" else 6 %}
{%- set tr = {"UDPOnly": 0, "TCPOnly": 1, "TLS": 2, "DNSnaptr": 0}[sip_transport] %}
{%- set https = server.provisioning_server_type == "HTTPS" %}
{#- Account n (1-6): the P-value of each setting. -#}
{%- set A = {
  "active": [271, 401, 501, 601, 1701, 1801],
  "name": [270, 417, 517, 617, 1717, 1817],
  "server": [47, 402, 502, 602, 1702, 1802],
  "user": [35, 404, 504, 604, 1704, 1804],
  "auth": [36, 405, 505, 605, 1705, 1805],
  "password": [34, 406, 506, 606, 1706, 1806],
  "display": [3, 407, 507, 607, 1707, 1807],
  "voicemail": [33, 426, 526, 626, 1726, 1826],
  "transport": [130, 448, 548, 648, 1748, 1848],
  "expires": [32, 412, 512, 612, 1712, 1812],
  "mwi": [99, 415, 515, 615, 1715, 1815],
  "intercom": [298, 438, 538, 638, 738, 838],
  "intercom_mute": [26071, 26171, 26271, 26371, 26471, 26571],
  "pickup": [1347, 481, 581, 681, 781, 881],
} %}
<gs_provision version="1">
<mac>{{ mac }}</mac>
<config version="1">
{% block registration %}
{% for line in lines if line.index <= max_accounts %}
{% set i = line.index - 1 %}
<!-- Account {{ line.index }}: {{ c(line.extension_number) }} -->
{{ p(A.active[i], 1) }}
{{ p(A.name[i], c(line.label or line.extension_number)) }}
{{ p(A.server[i], server.sip_host ~ ("" if server.sip_port == 5060 else ":" ~ server.sip_port)) }}
{{ p(A.user[i], line.sip_username) }}
{{ p(A.auth[i], line.sip_username) }}
{{ p(A.password[i], line.sip_password) }}
{{ p(A.display[i], c(line.caller_id_name or line.display_name or line.extension_number)) }}
{{ p(A.transport[i], tr) }}
{{ p(A.expires[i], [registration_expires // 60, 1] | max) }}
{{ p(A.voicemail[i], server.voicemail_number if line.voicemail else "") }}
{{ p(A.mwi[i], 1 if line.voicemail else 0) }}
{{ p(A.pickup[i], server.pickup_prefix) }}
{% endfor %}
{% if not lines %}
<!-- No extension assigned: nothing registers. -->
{% endif %}
{% endblock %}
{% block intercom %}
<!-- Intercom (docs/CALL_FEATURES.md §3.6): Veyra's intercom calls carry
     Call-Info answer-after=0, answered on the speaker. -->
{% for line in lines if line.index <= max_accounts %}
{% set i = line.index - 1 %}
{{ p(A.intercom[i], intercom_auto_answer | bool01) }}
{% if not (fam == "grp261x" and i == 0) %}
{{ p(A.intercom_mute[i], intercom_mic_muted | bool01) }}
{% endif %}
{% endfor %}
{% endblock %}
{% block keys %}
<!-- Programmable keys: numbered in order without gaps (Grandstream drops
     every key after an empty one). GXP fixed keys use their own codes. -->
{%- set gxp_fixed = {"GXP2130": 3, "GXP2135": 8, "GXP2140": 4, "GXP2160": 6, "GXP2170": 12}.get(model, 0) if fam == "gxp" else 0 %}
{%- set grp_code = {"line": 31, "blf": 1, "speed_dial": 0, "transfer": 8, "page": 13} %}
{%- set gxp_fixed_code = {"line": 0, "blf": 11, "speed_dial": 10, "transfer": 18, "page": 23} %}
{% for key in keys | selectattr("type", "in", ["line", "blf", "speed_dial", "transfer", "page"]) %}
{% set n = loop.index %}
{% if n <= 48 %}
{% set base = [1363 + 2 * (n - 1), 1364 + 2 * (n - 1), 1465 + 2 * (n - 1), 1466 + 2 * (n - 1)] if n <= 6 else [23800 + 4 * (n - 7), 23801 + 4 * (n - 7), 23802 + 4 * (n - 7), 23803 + 4 * (n - 7)] %}
{% set usable = not (key.type == "page" and not key.multicast_address) and not (key.type == "line" and n > gxp_fixed and fam == "gxp") %}
{% set mode = (gxp_fixed_code[key.type] if n <= gxp_fixed else grp_code[key.type]) if usable else -1 %}
{% if key.type == "line" %}
{% set account = ([key.value | int(1), 1] | max) - 1 %}{% set value = "" %}
{% elif key.type == "page" and usable %}
{% set account = 0 %}{% set value = key.multicast_address ~ ":" ~ key.multicast_port %}
{% elif key.type in ("transfer", "page") %}
{% set account = 0 %}{% set value = "" %}
{% else %}
{% set account = 0 %}{% set value = key.value %}
{% endif %}
{{ p(base[0], mode) }}
{{ p(base[1], account) }}
{{ p(base[2], c(key.label or key.value)) }}
{{ p(base[3], value) }}
{% endif %}
{% endfor %}
{% endblock %}
{% block paging %}
{% if paging.enabled %}
<!-- Multicast paging: plain RTP (channel 0), priority in the zones' order. -->
{% if fam != "gxp" %}
{{ p(22208, 1) }}
{% endif %}
{{ p(1568, 9 if paging.codec == "G.722" else 0) }}
{{ p(8454, 0) }}
{% for g in paging.groups if g.subscribed %}
{% if loop.index <= 10 %}
{{ p(1569 + 2 * (loop.index - 1), g.multicast_address ~ ":" ~ g.multicast_port) }}
{{ p(1570 + 2 * (loop.index - 1), c(g.label)) }}
{% endif %}
{% endfor %}
{% endif %}
{% endblock %}
{% block time %}
<!-- Time: the zone and daylight saving as a POSIX rule, so DHCP cannot change them. -->
{{ p(30, server.ntp_server) }}
{{ p(144, 0) }}
{{ p(143, 0) }}
{%- set off = server.dst.standard_offset %}
{%- macro posix(name, seconds) %}{% set a = seconds if seconds >= 0 else -seconds %}{{ name }}{{ "-" if seconds > 0 else "+" }}{{ a // 3600 }}{% if a % 3600 %}:{{ "%02d" | format((a % 3600) // 60) }}{% endif %}{% endmacro %}
{%- macro rule(r) %}M{{ r.month }}.{{ r.week }}.{{ r.day_of_week - 1 }}{% if r.hour != 2 %}/{{ r.hour }}{% endif %}{% endmacro %}
{{ p(64, "customize") }}
{% if server.dst.enabled %}
{{ p(246, posix("MTZ", off) ~ posix("MDT", off + 3600) ~ "," ~ rule(server.dst.start) ~ "," ~ rule(server.dst.stop)) }}
{% else %}
{{ p(246, posix("MTZ", off)) }}
{% endif %}
{% endblock %}
{% block provisioning %}
<!-- Provisioning: this server, the device credential, a daily check. -->
{{ p(212, 2 if https else 1) }}
{{ p(237, server.host ~ "/" ~ server.provisioning_path) }}
{% if device.credential_user %}
{{ p(1360, device.credential_user) }}
{{ p(1361, device.credential_password) }}
{{ p(20713, 1) }}
{% endif %}
{{ p(145, dhcp_override | bool01) }}
{{ p(194, 2) }}
{{ p(285, polling_hour % 24) }}
<!-- SIP NOTIFY check-sync from Veyra needs no authentication (1 on both families). -->
{{ p(4428, 1) }}
{% if server.firmware_url %}
{% set fw = server.firmware_url.split("://", 1)[1] %}
{{ p(6767, 2 if server.firmware_url.startswith("https") else 1) }}
{{ p(192, fw.rsplit("/", 1)[0]) }}
{{ p(238, 0) }}
{% else %}
<!-- No firmware assigned: the phone does not upgrade itself from Grandstream's server. -->
{{ p(238, 2) }}
{% endif %}
{% if install_ca and server.ca_certificate %}
{{ p(8433, server.ca_certificate) }}
{{ p(8502, 2) }}
{% endif %}
{{ p(8463, validate_server_certificate | bool01) }}
{% if vlan_id %}
{{ p(22174, 1) }}
{{ p(51, vlan_id) }}
{% endif %}
{% if admin_password %}
{{ p(2, admin_password) }}
{% endif %}
{% if directory_enabled %}
{% set dir = server.directory_url.split("://", 1)[1] %}
{{ p(330, 3 if server.directory_url.startswith("https") else 1) }}
{{ p(331, ((device.credential_user ~ ":" ~ device.credential_password ~ "@") if device.credential_user else "") ~ dir ~ "grandstream.xml") }}
{{ p(332, 60) }}
{% else %}
{{ p(330, 0) }}
{% endif %}
{% endblock %}
{% block hotline %}
<!-- Hotline (issue #168): lifting the handset dials the first line's
     hotline number, after the delay without a digit (warm line). -->
{% set hl = lines[0] if lines else None %}
{% if hl and hl.get("hotline") %}
{{ p(71, c(hl.hotline)) }}
{{ p(8388, hl.get("hotline_delay", 0)) }}
{% else %}
{{ p(71, "") }}
{% endif %}
{% endblock %}
{% block model_settings %}{% endblock %}
</config>
</gs_provision>
